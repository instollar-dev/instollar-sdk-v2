{
  "name": "@instollar-dev/instollar-sdk",
  "version": "0.9.19",
  "description": "Instollar SDK \u2014 React web UI, HTTP client, storage, and shared app data",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./alert-text": {
      "types": "./dist/alert-text.d.ts",
      "import": "./dist/alert-text.js",
      "require": "./dist/alert-text.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./theme.css": "./theme.css",
    "./countries": {
      "types": "./dist/countries.d.ts",
      "import": "./dist/countries.js",
      "require": "./dist/countries.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.cjs"
    }
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "tsup && pnpm build:assets",
    "build:assets": "node -e \"const fs=require('fs');fs.copyFileSync('../react/dist/styles.css','dist/styles.css');fs.copyFileSync('../react/dist/components.css','dist/components.css')\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@instollar-dev/instollar-core": "workspace:*",
    "@instollar-dev/instollar-react": "workspace:*",
    "@instollar-dev/instollar-tokens": "workspace:*"
  },
  "peerDependencies": {
    "expo-secure-store": "*",
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instollar-dev/instollar-sdk-v2.git"
  }
}