{
  "name": "@instollar-dev/instollar-react",
  "version": "0.6.5",
  "description": "Instollar React web UI components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./alert-text": {
      "types": "./dist/components/AlertText.d.ts",
      "import": "./dist/components/AlertText.js",
      "require": "./dist/components/AlertText.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist",
    "src/styles/theme.css",
    "src/styles/theme-base.css",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@instollar-dev/instollar-core": "workspace:*",
    "@instollar-dev/instollar-tokens": "workspace:*",
    "clsx": "^2.1.1",
    "iconsax-react": "^0.0.8",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instollar-dev/instollar-sdk-v2.git"
  }
}