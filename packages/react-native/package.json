{
  "name": "@instollar-dev/instollar-react-native",
  "version": "0.9.12",
  "description": "Instollar React Native UI components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@instollar-dev/instollar-core": "workspace:*",
    "@instollar-dev/instollar-tokens": "workspace:*",
    "iconsax-react-native": "^0.0.8"
  },
  "peerDependencies": {
    "expo-document-picker": "*",
    "expo-haptics": "*",
    "expo-image-picker": "*",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-reanimated": ">=3",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "expo-document-picker": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "expo-haptics": "^15.0.0",
    "react": "^19.0.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.15.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instollar-dev/instollar-sdk-v2.git"
  }
}
